---
import BaseLayout from './BaseLayout.astro';
import { getEntry } from 'astro:content';
import '../styles/prose.css';
import Breadcrumbs from '../components/article/Breadcrumbs.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import AuthorBox from '../components/article/AuthorBox.astro';

interface FrontmatterShape {
  title: string;
  description: string;
  h1?: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  authorRef?: string;
  breadcrumbs?: Array<{ name: string; url?: string }>;
  showToc?: boolean;
  hero?: string;
  heroAlt?: string;
  category?: string;
  readingTime?: number;
}

interface Props extends Partial<FrontmatterShape> {
  frontmatter?: FrontmatterShape;
}

const fm: FrontmatterShape = (Astro.props.frontmatter ?? Astro.props) as FrontmatterShape;

const {
  title,
  description,
  h1,
  pubDate: pubDateRaw,
  updatedDate: updatedDateRaw,
  authorRef = 'editorial',
  breadcrumbs = [],
  showToc = true,
  hero,
  heroAlt,
  category,
  readingTime,
} = fm;

const pubDate = pubDateRaw instanceof Date ? pubDateRaw : new Date(pubDateRaw);
const updatedDate = updatedDateRaw
  ? updatedDateRaw instanceof Date
    ? updatedDateRaw
    : new Date(updatedDateRaw)
  : undefined;

const heading = h1 ?? title;
const author = await getEntry('authors', authorRef);
const authorName = author?.data.name ?? 'Редакция AppsGames';

const siteUrl = Astro.site ?? new URL('https://appsgames.ru');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'ru-RU',
  author: {
    '@type': 'Person',
    name: authorName,
    url: author?.data.url,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AppsGames.ru',
    url: 'https://appsgames.ru/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://appsgames.ru/favicon.svg',
    },
  },
  mainEntityOfPage: canonicalUrl,
  ...(hero ? { image: new URL(hero, siteUrl).toString() } : {}),
};

const fmt = new Intl.DateTimeFormat('ru-RU', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} ogType="article" image={hero}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <article class="article container">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

    <header class="article__head">
      {category && <p class="article__cat">{category}</p>}
      <h1 class="article__title">{heading}</h1>
      <p class="article__meta">
        <span>{authorName}</span>
        <span aria-hidden="true"> · </span>
        <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true"> · </span>
            <span>обновлено {fmt.format(updatedDate)}</span>
          </>
        )}
        {readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{readingTime} мин чтения</span>
          </>
        )}
      </p>
    </header>

    {hero && (
      <figure class="article__hero">
        <img src={hero} alt={heroAlt ?? heading} loading="eager" />
      </figure>
    )}

    {showToc && <TableOfContents />}

    <div class="prose" data-article-body>
      <slot />
    </div>

    {author && (
      <AuthorBox author={author} pubDate={pubDate} updatedDate={updatedDate} />
    )}
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 860px;
    padding-top: clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .article__head {
    margin-bottom: 1.5rem;
  }
  .article__cat {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .article__title {
    margin: 0 0 0.9rem;
    font-size: clamp(1.8rem, 1.4rem + 2.2vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
  .article__meta {
    margin: 0;
    color: var(--fg-subtle);
    font-size: 0.92rem;
  }
  .article__hero {
    margin: 1.5rem 0 2rem;
  }
  .article__hero img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }
</style>
