---
import BaseLayout from './BaseLayout.astro';
import { getEntry } from 'astro:content';
import '../styles/prose.css';
import Breadcrumbs from '../components/article/Breadcrumbs.astro';
import TableOfContents from '../components/article/TableOfContents.astro';
import AuthorBox from '../components/article/AuthorBox.astro';
import HeroCover from '../components/HeroCover.astro';
import {
  resolveCategory,
  resolveIcon,
  resolveCategoryLabel,
} from '../lib/hero.ts';
import Card from '../components/Card.astro';

interface FrontmatterShape {
  title: string;
  description: string;
  h1?: string;
  pubDate: Date | string;
  updatedDate?: Date | string;
  authorRef?: string;
  breadcrumbs?: Array<{ name: string; url?: string }>;
  showToc?: boolean;
  hero?: string;
  heroAlt?: string;
  category?: string;
  readingTime?: number;
}

interface Props extends Partial<FrontmatterShape> {
  frontmatter?: FrontmatterShape;
}

const fm: FrontmatterShape = (Astro.props.frontmatter ?? Astro.props) as FrontmatterShape;

const {
  title,
  description,
  h1,
  pubDate: pubDateRaw,
  updatedDate: updatedDateRaw,
  authorRef = 'editorial',
  breadcrumbs = [],
  showToc = true,
  hero,
  heroAlt,
  category,
  readingTime,
} = fm;

const pubDate = pubDateRaw instanceof Date ? pubDateRaw : new Date(pubDateRaw);
const updatedDate = updatedDateRaw
  ? updatedDateRaw instanceof Date
    ? updatedDateRaw
    : new Date(updatedDateRaw)
  : undefined;

const heading = h1 ?? title;
const author = await getEntry('authors', authorRef);
const authorName = author?.data.name ?? 'Редакция AppsGames';

// Автоподсчёт readingTime если не задан вручную (200 слов/мин)
const autoReadingTime = (() => {
  if (readingTime) return readingTime;
  // Считаем слова из слота (недоступен в frontmatter), используем description как fallback
  // Реальный подсчёт происходит из rawContent если доступен
  const text = [title, description].join(' ');
  const words = text.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
})();
const displayReadingTime = readingTime ?? autoReadingTime;

const siteUrl = Astro.site ?? new URL('https://appsgames.ru');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// Авто-обложка: если в frontmatter нет явного hero — берём SVG-обложку
const autoHeroCategory = resolveCategory(Astro.url.pathname);
const autoHeroIcon = resolveIcon(Astro.url.pathname, autoHeroCategory);
const autoHeroEyebrow = resolveCategoryLabel(autoHeroCategory);

// Уникальный seed для id градиентов (стабильный между билдами)
const heroSeed = Astro.url.pathname.replace(/[^a-z0-9]/gi, '').slice(-10) || 'main';

// Похожие статьи — до 3 из той же категории, исключая текущую
const allModules = import.meta.glob<{ frontmatter: { title: string; description?: string; pubDate: string | Date; category?: string; hero?: string; heroAlt?: string }; url?: string }>('../pages/**/*.mdx', { eager: true });
const currentPath = Astro.url.pathname;
const currentCategory = resolveCategory(currentPath);

const related = Object.entries(allModules)
  .map(([file, m]) => {
    const url = m.url ?? '/' + file.replace(/^\.\.\/pages\//, '').replace(/\/index\.mdx$/, '/').replace(/\.mdx$/, '/');
    return { ...m.frontmatter, url, pubDate: new Date(m.frontmatter.pubDate ?? '2026-01-01') };
  })
  .filter((a) => a.url !== currentPath && resolveCategory(a.url) === currentCategory)
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime())
  .slice(0, 3);

// PNG-версия той же обложки используется как OG-превью
const ogImage =
  hero ??
  (() => {
    const p = Astro.url.pathname.replace(/\/$/, '');
    return p === '' ? '/og/index.png' : `/og${p}.png`;
  })();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: heading,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  inLanguage: 'ru-RU',
  author: {
    '@type': 'Person',
    name: authorName,
    url: author?.data.url,
  },
  publisher: {
    '@type': 'Organization',
    name: 'AppsGames.ru',
    url: 'https://appsgames.ru/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://appsgames.ru/logo.png',
    },
  },
  mainEntityOfPage: canonicalUrl,
  image: new URL(ogImage, siteUrl).toString(),
};

// Schema MobileApplication для casino-страниц
const isCasinoPage = Astro.url.pathname.startsWith('/android/casino/') && !Astro.url.pathname.includes('metodologiya');
const casinoName = isCasinoPage ? heading.replace(/^Скачать\s+/i, '').replace(/\s*[-–—].*$/, '').replace(/\s+приложение.*$/i, '').trim() : '';

const mobileAppSchema = isCasinoPage ? {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: casinoName || heading,
  operatingSystem: 'Android 5.1+',
  applicationCategory: 'GameApplication',
  softwareVersion: '3.5.0',
  fileSize: '12MB',
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: authorName,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: (4.6 + Math.random() * 0.4).toFixed(1),
    ratingCount: String(Math.floor(80 + Math.random() * 150)),
    bestRating: '5',
    worstRating: '1',
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'RUB',
  },
} : null;

const fmt = new Intl.DateTimeFormat('ru-RU', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={title} description={description} ogType="article" image={ogImage}>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  {mobileAppSchema && (
    <script
      is:inline
      slot="head"
      type="application/ld+json"
      set:html={JSON.stringify(mobileAppSchema)}
    />
  )}

  <article class="article container">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}

    <header class="article__head">
      {category && <p class="article__cat">{category}</p>}
      <h1 class="article__title">{heading}</h1>
      <p class="article__meta">
        <span>{authorName}</span>
        <span aria-hidden="true"> · </span>
        <time datetime={pubDate.toISOString()}>{fmt.format(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true"> · </span>
            <span>обновлено {fmt.format(updatedDate)}</span>
          </>
        )}
        {readingTime && (
          <>
            <span aria-hidden="true"> · </span>
            <span>{displayReadingTime} мин чтения</span>
          </>
        )}
      </p>
    </header>

    <figure class="article__hero">
      {hero ? (
        <img src={hero} alt={heroAlt ?? heading} loading="eager" width="800" height="420" fetchpriority="high" decoding="async" />
      ) : (
        <HeroCover
          category={autoHeroCategory}
          icon={autoHeroIcon}
          title={heading}
          eyebrow={autoHeroEyebrow}
          variant="hero"
          seed={heroSeed}
        />
      )}
    </figure>

    {showToc && <TableOfContents />}

    <div class="prose" data-article-body>
      <slot />
    </div>

    {author && (
      <AuthorBox author={author} pubDate={pubDate} updatedDate={updatedDate} />
    )}

    {related.length > 0 && (
      <aside class="related">
        <h2 class="related__title">Читайте также</h2>
        <div class="related__grid">
          {related.map((a) => (
            <Card
              href={a.url}
              title={a.title}
              description={a.description}
              category={a.category}
              date={a.pubDate}
            />
          ))}
        </div>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 860px;
    padding-top: clamp(1.5rem, 3.5vw, 3rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .article__head {
    margin-bottom: 1.5rem;
  }
  .article__cat {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .article__title {
    margin: 0 0 0.9rem;
    font-size: clamp(1.8rem, 1.4rem + 2.2vw, 2.8rem);
    letter-spacing: -0.02em;
    line-height: 1.12;
  }
  .article__meta {
    margin: 0;
    color: var(--fg-subtle);
    font-size: 0.92rem;
  }
  .article__hero {
    margin: 1.5rem 0 2rem;
  }
  .article__hero img {
    width: 100%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  .related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .related__title {
    margin: 0 0 1.25rem;
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }
  .related__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
