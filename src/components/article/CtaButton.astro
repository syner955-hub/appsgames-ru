---
interface Props {
  href: string;
  label?: string;
}
const { href, label = 'Скачать приложение' } = Astro.props;
---

<a class="cta-btn" href={href} target="_blank" rel="nofollow sponsored noopener">
  {label}
</a>

<style>
  .cta-btn {
    display: block;
    width: 100%;
    max-width: 400px;
    margin: 1.5rem auto;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, #0a84ff 0%, #0050d4 100%);
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    border-radius: 12px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 4px 14px rgba(10, 132, 255, 0.3);
  }
  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(10, 132, 255, 0.4);
    text-decoration: none;
    color: #ffffff;
  }
  .cta-btn:active {
    transform: translateY(0);
  }
</style>
