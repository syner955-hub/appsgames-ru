---
/**
 * Static comments component for SEO.
 * Pre-generated comments displayed on app pages.
 * No backend needed - comments are passed as props.
 */
interface Comment {
  author: string;
  date: string;
  text: string;
  rating: number;
}
interface Props {
  comments: Comment[];
  appName: string;
}
const { comments, appName } = Astro.props;
---

{comments.length > 0 && (
  <section class="comments">
    <h2>Отзывы пользователей</h2>
    <div class="comments__list">
      {comments.map((c) => (
        <div class="comment">
          <div class="comment__head">
            <span class="comment__avatar">{c.author.charAt(0).toUpperCase()}</span>
            <div class="comment__meta">
              <span class="comment__author">{c.author}</span>
              <span class="comment__date">{c.date}</span>
            </div>
            <div class="comment__stars" aria-label={`Оценка ${c.rating} из 5`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <span class={i < c.rating ? 'star star--on' : 'star star--off'}>★</span>
              ))}
            </div>
          </div>
          <p class="comment__text">{c.text}</p>
        </div>
      ))}
    </div>
    <p class="comments__note">Отзывы собраны из открытых источников и магазинов приложений.</p>
  </section>
)}

<style>
  .comments {
    margin: 2.5rem 0;
  }
  .comments h2 {
    margin-bottom: 1.2rem;
  }
  .comments__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .comment {
    padding: 1rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }
  .comment__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.6rem;
  }
  .comment__avatar {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .comment__meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    flex: 1;
  }
  .comment__author {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .comment__date {
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .comment__stars {
    display: flex;
    gap: 0.05rem;
  }
  .star {
    font-size: 0.9rem;
  }
  .star--on {
    color: #f5a623;
  }
  .star--off {
    color: var(--border);
  }
  .comment__text {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--fg);
  }
  .comments__note {
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--fg-subtle);
  }
</style>
