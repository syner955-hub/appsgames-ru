---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  planned: string[];
}
const { eyebrow, title, lead, planned } = Astro.props;
---

<section class="hub container">
  <header class="hub__head">
    <p class="hub__eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="hub__lead">{lead}</p>
  </header>

  <section class="hub__group">
    <h2>Готовится</h2>
    <ul class="hub__planned">
      {planned.map((p) => <li>{p}</li>)}
    </ul>
  </section>
</section>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head { margin-bottom: 2.5rem; }
  .hub__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead {
    margin: 0; font-size: 1.1rem; color: var(--fg-muted);
    max-width: 60ch;
  }
  .hub__group { margin-top: 2rem; }
  .hub__group > h2 {
    font-size: 0.78rem; text-transform: uppercase;
    letter-spacing: 0.12em; color: var(--fg-subtle);
    font-weight: 700; margin: 0 0 1.1rem;
  }
  .hub__planned {
    margin: 0; padding-left: 1.2rem; color: var(--fg-muted);
  }
  .hub__planned li { margin-bottom: 0.3rem; }
</style>
