---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AppsGames.ru — обзоры и советы по приложениям для iOS и Android';
const description =
  'Обновляем сайт: делаем современные обзоры приложений для iPhone и Android, инструкции и разборы частых проблем. Скоро запустим новые разделы.';
---

<BaseLayout title={title} description={description} noindex>
  <section class="hero container">
    <p class="hero__eyebrow">AppsGames.ru · обновление</p>
    <h1 class="hero__title">
      Делаем новый сайт про&nbsp;приложения для&nbsp;iOS и&nbsp;Android
    </h1>
    <p class="hero__lead">
      Мы перезапускаем AppsGames.ru: новый дизайн, свежие обзоры и понятные
      инструкции. В ближайшие недели здесь появятся разборы приложений, советы
      по iPhone и Android, гайды по безопасности и сравнения сервисов.
    </p>

    <div class="hero__cards">
      <article class="hero-card">
        <h2>Что готовим</h2>
        <ul>
          <li>Обзоры приложений для iOS и Android</li>
          <li>Практические инструкции без воды</li>
          <li>Сравнения аналогов и подборки</li>
          <li>Советы по безопасности и настройкам</li>
        </ul>
      </article>

      <article class="hero-card">
        <h2>Для кого</h2>
        <p>
          Для тех, кто хочет быстро понять — нужно ему приложение или нет, как
          починить проблему с телефоном и какой софт выбрать под задачу.
        </p>
      </article>

      <article class="hero-card">
        <h2>Подписаться</h2>
        <p>
          Пока готовим первые материалы, напишите нам, если хотите стать автором
          или предложить тему:
          <a href="mailto:hello@appsgames.ru">hello@appsgames.ru</a>.
        </p>
      </article>
    </div>

    <p class="hero__note">
      Сайт временно закрыт от индексации — запустим публично, когда будут готовы
      первые разделы.
    </p>
  </section>

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AppsGames.ru',
      url: 'https://appsgames.ru/',
      inLanguage: 'ru-RU',
      publisher: {
        '@type': 'Organization',
        name: 'AppsGames.ru',
        url: 'https://appsgames.ru/',
      },
    })}
  />
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 7vw, 6rem) 0 clamp(2rem, 5vw, 4rem);
    max-width: 960px;
  }
  .hero__eyebrow {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.78rem;
    margin: 0 0 1rem;
  }
  .hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.1rem, 1.6rem + 2.8vw, 3.6rem);
    letter-spacing: -0.025em;
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .hero__cards {
    margin: 2.5rem 0 2rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 780px) {
    .hero__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .hero-card {
    padding: 1.25rem 1.4rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .hero-card h2 {
    font-size: 1.05rem;
    margin: 0 0 0.6rem;
  }
  .hero-card ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .hero-card ul li {
    margin-bottom: 0.25rem;
  }
  .hero-card p {
    margin: 0;
    color: var(--fg-muted);
  }
  .hero__note {
    margin-top: 2rem;
    padding: 0.9rem 1.1rem;
    background: var(--bg-soft);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
    color: var(--fg-subtle);
    font-size: var(--fs-sm);
  }
</style>
