---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'AppsGames.ru — обзоры и инструкции для iPhone и Android';
const description =
  'Обзоры приложений и подробные инструкции для iOS и Android: синхронизация, бэкапы, безопасность, эмуляторы и альтернативы магазинов. Проверено на актуальных версиях.';

const featured = [
  {
    href: '/obzory/luchshie-messenzhery-2026/',
    category: 'Обзоры',
    title: 'Лучшие мессенджеры 2026 года',
    desc: 'Telegram, WhatsApp, Max, Signal, Viber, Discord — для каких сценариев что подходит.',
  },
  {
    href: '/bezopasnost/kak-nastroit-dvuhfaktornuyu-autentifikaciyu/',
    category: 'Безопасность',
    title: 'Как настроить двухфакторную аутентификацию',
    desc: '2FA для Apple ID, Google, банков и мессенджеров. Что выбрать и как делать бэкап.',
  },
  {
    href: '/sovety/kak-sehkonomit-batareyu-iphone/',
    category: 'Советы',
    title: 'Как сэкономить батарею iPhone',
    desc: '15 рабочих настроек — без мифов про закрытие приложений свайпом.',
  },
  {
    href: '/obzory/menedzhery-parolei/',
    category: 'Обзоры',
    title: 'Лучшие менеджеры паролей',
    desc: '1Password, Bitwarden, iCloud Keychain, Proton Pass. Что выбрать и как перейти.',
  },
  {
    href: '/ios/kak-sdelat/perenesti-dannyie-na-novyi-iphone/',
    category: 'iOS',
    title: 'Как перенести данные на новый iPhone',
    desc: 'Быстрое начало по кабелю, iCloud-бэкап и локальный. Что делать с WhatsApp и Telegram.',
  },
  {
    href: '/android/kak-sdelat/sbros-nastroek-android/',
    category: 'Android',
    title: 'Как сбросить Android до заводских',
    desc: 'Через настройки, Recovery и удалённо. Подготовка и защита от FRP-блокировки.',
  },
];

const clusters = [
  {
    href: '/ios/',
    title: 'iOS',
    desc: 'iPhone и iPad: инструкции, обзоры, решение проблем.',
  },
  {
    href: '/android/',
    title: 'Android',
    desc: 'Настройка, установка приложений, сервис, эмуляторы.',
  },
  {
    href: '/obzory/',
    title: 'Обзоры',
    desc: 'Сравнения и подборки приложений под конкретные задачи.',
  },
  {
    href: '/bezopasnost/',
    title: 'Безопасность',
    desc: 'Защита аккаунтов, проверка APK, восстановление доступа.',
  },
  {
    href: '/sovety/',
    title: 'Советы',
    desc: 'Практические материалы, которые экономят время.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hero container">
    <p class="hero__eyebrow">AppsGames.ru</p>
    <h1 class="hero__title">
      Обзоры и инструкции для&nbsp;iPhone и&nbsp;Android
    </h1>
    <p class="hero__lead">
      Пишем понятные гайды: как починить, настроить и заставить работать всё,
      что связано со смартфонами. Проверяем на актуальных версиях iOS и Android
      и указываем дату обновления каждого материала.
    </p>
  </section>

  <section class="home-section container">
    <h2 class="home-section__title">Свежие материалы</h2>
    <ul class="feat__list">
      {featured.map((a) => (
        <li class="feat__item">
          <a href={a.href}>
            <p class="feat__cat">{a.category}</p>
            <h3>{a.title}</h3>
            <p class="feat__desc">{a.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-section container">
    <h2 class="home-section__title">Разделы</h2>
    <ul class="clusters__list">
      {clusters.map((c) => (
        <li class="clusters__item">
          <a href={c.href}>
            <h3>{c.title}</h3>
            <p>{c.desc}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AppsGames.ru',
      url: 'https://appsgames.ru/',
      inLanguage: 'ru-RU',
      publisher: {
        '@type': 'Organization',
        name: 'AppsGames.ru',
        url: 'https://appsgames.ru/',
      },
    })}
  />
</BaseLayout>

<style>
  .hero {
    padding: clamp(3rem, 6vw, 5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
    max-width: 860px;
  }
  .hero__eyebrow {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.78rem;
    margin: 0 0 1rem;
  }
  .hero__title {
    margin: 0 0 1.25rem;
    font-size: clamp(2.1rem, 1.6rem + 2.8vw, 3.4rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
  }
  .hero__lead {
    font-size: var(--fs-lg);
    color: var(--fg-muted);
    max-width: 60ch;
  }

  .home-section {
    max-width: 960px;
    padding-top: clamp(2rem, 3vw, 3rem);
    padding-bottom: clamp(1.5rem, 2vw, 2rem);
  }
  .home-section__title {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    font-weight: 700;
    margin: 0 0 1.2rem;
  }

  .feat__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .feat__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1060px) {
    .feat__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .feat__item a {
    display: block;
    padding: 1.2rem 1.3rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: border-color 0.15s, transform 0.15s;
  }
  .feat__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-2px);
  }
  .feat__cat {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .feat__item h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .feat__desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .clusters__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .clusters__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .clusters__list {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .clusters__item a {
    display: block;
    padding: 1.1rem 1.2rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none;
    color: var(--fg);
    height: 100%;
    transition: border-color 0.15s;
  }
  .clusters__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
  }
  .clusters__item h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .clusters__item p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
</style>
