---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Скачать игры и приложения для Android бесплатно — AppsGames.ru';
const description = 'Каталог игр и приложений для Android. Скачивайте APK бесплатно: казино, мессенджеры, навигаторы, банковские приложения и утилиты.';

const categories = [
  { href: '/android/casino/', name: 'Казино', count: 28, icon: '🎰' },
  { href: '/apps/', name: 'Приложения', count: 15, icon: '📱' },
  { href: '/android/', name: 'Android гайды', count: 8, icon: '🤖' },
  { href: '/ios/', name: 'iOS гайды', count: 11, icon: '🍎' },
];

const casinoApps = [
  { href: '/android/casino/7k-casino/', name: '7K Casino', desc: '1000+ слотов, лайв-казино', bonus: '100% + 50 FS', image: '/images/casino/7k-casino-logo.webp' },
  { href: '/android/casino/vavada/', name: 'Vavada', desc: '5000+ игр, 100 FS без депозита', bonus: '100 FS бездеп', image: '/images/casino/vavada-logo.webp' },
  { href: '/android/casino/legzo-casino/', name: 'Legzo', desc: '5000+ игр от 60 провайдеров', bonus: '200% + 100 FS', image: '/images/casino/legzo-casino-logo.webp' },
  { href: '/android/casino/starda-casino/', name: 'Starda', desc: 'Пакет до 500% на 4 депозита', bonus: '200% + 50 FS', image: '/images/casino/starda-casino-logo.webp' },
  { href: '/android/casino/beef-casino/', name: 'Beef Casino', desc: '4000+ игр, вывод от 5 мин', bonus: '150% + 40 FS', image: '/images/casino/beef-casino-logo.webp' },
  { href: '/android/casino/kometa-casino/', name: 'Kometa', desc: '4000+ игр, мобильные бонусы', bonus: '100% + 200 FS', image: '/images/casino/kometa-casino-logo.webp' },
];

const apps = [
  { href: '/apps/telegram/', name: 'Telegram', desc: 'Мессенджер с каналами и ботами', image: '/images/apps/telegram.webp' },
  { href: '/apps/whatsapp/', name: 'WhatsApp', desc: 'Звонки и переписка с шифрованием', image: '/images/apps/whatsapp.webp' },
  { href: '/apps/vk/', name: 'ВКонтакте', desc: 'Соцсеть с музыкой и видео', image: '/images/apps/vk.webp' },
  { href: '/apps/sberbank/', name: 'Сбербанк', desc: 'Переводы, платежи, вклады', image: '/images/apps/sberbank.webp' },
  { href: '/apps/minecraft/', name: 'Minecraft', desc: 'Песочница с открытым миром', image: '/images/apps/minecraft.webp' },
  { href: '/apps/adguard/', name: 'AdGuard', desc: 'Блокировщик рекламы', image: '/images/apps/adguard.webp' },
];
---

<BaseLayout title={title} description={description}>
  <h1 class="sr-only">Скачать игры и приложения для Android бесплатно</h1>

  <section class="home-cats container">
    <div class="cats-grid">
      {categories.map((c) => (
        <a href={c.href} class="cat-card">
          <span class="cat-card__icon">{c.icon}</span>
          <span class="cat-card__name">{c.name}</span>
          <span class="cat-card__count">{c.count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section container">
    <header class="section-head">
      <h2>Казино на Android</h2>
      <a href="/android/casino/" class="section-head__link">Все казино →</a>
    </header>
    <div class="apps-grid">
      {casinoApps.map((app) => (
        <a href={app.href} class="app-item">
          <img src={app.image} alt={app.name} width="48" height="48" loading="lazy" class="app-item__icon" />
          <div class="app-item__body">
            <span class="app-item__name">{app.name}</span>
            <span class="app-item__desc">{app.desc}</span>
          </div>
          <span class="app-item__badge">{app.bonus}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section container">
    <header class="section-head">
      <h2>Приложения</h2>
      <a href="/apps/" class="section-head__link">Все приложения →</a>
    </header>
    <div class="apps-grid">
      {apps.map((app) => (
        <a href={app.href} class="app-item">
          <img src={app.image} alt={app.name} width="48" height="48" loading="lazy" class="app-item__icon" />
          <div class="app-item__body">
            <span class="app-item__name">{app.name}</span>
            <span class="app-item__desc">{app.desc}</span>
          </div>
          <span class="app-item__btn">Скачать</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-text container">
    <h2>О каталоге</h2>
    <p>AppsGames.ru — каталог игр и приложений для Android. Здесь можно скачать APK-файлы мобильных казино, мессенджеров, навигаторов и утилит. Все приложения проверены на работоспособность и совместимость с актуальными версиями Android.</p>
    <p>Для каждого приложения доступен обзор с описанием функций, системными требованиями, инструкцией по установке и ссылками на официальные источники.</p>
  </section>

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AppsGames.ru',
      url: 'https://appsgames.ru/',
      inLanguage: 'ru-RU',
      publisher: {
        '@type': 'Organization',
        name: 'AppsGames.ru',
        url: 'https://appsgames.ru/',
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://appsgames.ru/?s={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    })}
  />
</BaseLayout>

<style>
  .home-cats {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }
  @media (min-width: 640px) {
    .cats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cat-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 0.12s ease, border-color 0.15s ease;
  }
  .cat-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    text-decoration: none;
  }
  .cat-card__icon {
    font-size: 1.5rem;
  }
  .cat-card__name {
    font-weight: 600;
    font-size: 0.95rem;
    flex: 1;
  }
  .cat-card__count {
    font-size: 0.78rem;
    color: var(--fg-subtle);
    background: var(--bg-soft);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .home-section {
    padding: clamp(1rem, 2vw, 1.5rem) 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .section-head__link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .apps-grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .app-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 0.12s ease, border-color 0.15s ease;
  }
  .app-item:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border));
    text-decoration: none;
  }
  .app-item__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .app-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .app-item__name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .app-item__desc {
    font-size: 0.8rem;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .app-item__badge {
    flex-shrink: 0;
    padding: 0.3rem 0.6rem;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 6px;
    white-space: nowrap;
  }
  .app-item__btn {
    flex-shrink: 0;
    padding: 0.4rem 0.8rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 6px;
  }

  .home-text {
    padding: clamp(2rem, 3vw, 3rem) 0;
  }
  .home-text h2 {
    font-size: 1.2rem;
    margin: 0 0 0.8rem;
  }
  .home-text p {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.8rem;
  }
</style>
