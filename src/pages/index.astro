---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Скачать игры и приложения для Android бесплатно — AppsGames.ru';
const description = 'Каталог игр и приложений для Android. Скачивайте APK бесплатно: мессенджеры, навигаторы, банковские приложения, игры и утилиты с обзорами.';

const categories = [
  { href: '/apps/games/', name: 'Игры', count: 29, icon: '🎮' },
  { href: '/apps/programs/', name: 'Программы', count: 55, icon: '📱' },
  { href: '/apps/', name: 'Весь каталог', count: 84, icon: '📂' },
  { href: '/apps/search/', name: 'Поиск', count: 0, icon: '🔍' },
];

const apps = [
  { href: '/apps/telegram/', name: 'Telegram', desc: 'Мессенджер с каналами и ботами', image: '/images/apps/telegram.webp', category: 'Мессенджеры' },
  { href: '/apps/whatsapp/', name: 'WhatsApp', desc: 'Звонки и переписка с шифрованием', image: '/images/apps/whatsapp.webp', category: 'Мессенджеры' },
  { href: '/apps/tiktok/', name: 'TikTok', desc: 'Короткие видео и тренды', image: '/images/apps/tiktok.webp', category: 'Соцсети' },
  { href: '/apps/instagram/', name: 'Instagram', desc: 'Фото, Stories и Reels', image: '/images/apps/instagram.webp', category: 'Соцсети' },
  { href: '/apps/vk/', name: 'ВКонтакте', desc: 'Соцсеть с музыкой и видео', image: '/images/apps/vk.webp', category: 'Соцсети' },
  { href: '/apps/youtube/', name: 'YouTube', desc: 'Видеохостинг с миллиардами роликов', image: '/images/apps/youtube.webp', category: 'Мультимедиа' },
  { href: '/apps/spotify/', name: 'Spotify', desc: 'Стриминг музыки и подкастов', image: '/images/apps/spotify.webp', category: 'Мультимедиа' },
  { href: '/apps/sberbank/', name: 'Сбербанк', desc: 'Переводы, платежи, вклады', image: '/images/apps/sberbank.webp', category: 'Финансы' },
  { href: '/apps/tinkoff/', name: 'Тинькофф', desc: 'Банк с инвестициями и кэшбэком', image: '/images/apps/tinkoff.webp', category: 'Финансы' },
  { href: '/apps/yandex-navigator/', name: 'Яндекс Навигатор', desc: 'Пробки, камеры, маршруты', image: '/images/apps/yandex-navigator.webp', category: 'Навигация' },
  { href: '/apps/google-maps/', name: 'Google Maps', desc: 'Карты, маршруты и панорамы', image: '/images/apps/google-maps.webp', category: 'Навигация' },
  { href: '/apps/ozon/', name: 'Ozon', desc: 'Маркетплейс с быстрой доставкой', image: '/images/apps/ozon.webp', category: 'Покупки' },
  { href: '/apps/wildberries/', name: 'Wildberries', desc: 'Маркетплейс одежды и товаров', image: '/images/apps/wildberries.webp', category: 'Покупки' },
  { href: '/apps/subway-surfers/', name: 'Subway Surfers', desc: 'Бесконечный раннер', image: '/images/apps/subway-surfers.webp', category: 'Игры' },
  { href: '/apps/brawl-stars/', name: 'Brawl Stars', desc: 'Мультиплеерный шутер 3v3', image: '/images/apps/brawl-stars.webp', category: 'Игры' },
  { href: '/apps/minecraft/', name: 'Minecraft', desc: 'Песочница с открытым миром', image: '/images/apps/minecraft.webp', category: 'Игры' },
  { href: '/apps/genshin-impact/', name: 'Genshin Impact', desc: 'RPG с открытым миром', image: '/images/apps/genshin-impact.webp', category: 'Игры' },
  { href: '/apps/pubg-mobile/', name: 'PUBG Mobile', desc: 'Королевская битва на 100 игроков', image: '/images/apps/pubg-mobile.webp', category: 'Игры' },
  { href: '/apps/roblox/', name: 'Roblox', desc: 'Платформа с миллионами игр', image: '/images/apps/roblox.webp', category: 'Игры' },
  { href: '/apps/clash-of-clans/', name: 'Clash of Clans', desc: 'Стройте деревню и атакуйте', image: '/images/apps/clash-of-clans.webp', category: 'Игры' },
];
---

<BaseLayout title={title} description={description}>
  <h1 class="sr-only">Скачать игры и приложения для Android бесплатно</h1>

  <section class="home-cats container">
    <div class="cats-grid">
      {categories.map((c) => (
        <a href={c.href} class="cat-card">
          <span class="cat-card__icon">{c.icon}</span>
          <span class="cat-card__name">{c.name}</span>
          <span class="cat-card__count">{c.count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section container">
    <header class="section-head">
      <h2>Популярные приложения</h2>
      <a href="/apps/" class="section-head__link">Все приложения →</a>
    </header>
    <div class="apps-grid">
      {apps.map((app) => (
        <a href={app.href} class="app-item">
          <img src={app.image} alt={app.name} width="48" height="48" loading="lazy" class="app-item__icon" />
          <div class="app-item__body">
            <span class="app-item__name">{app.name}</span>
            <span class="app-item__desc">{app.desc}</span>
          </div>
          <span class="app-item__badge">{app.category}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-text container">
    <h2>О каталоге</h2>
    <p>AppsGames.ru — каталог игр и приложений для Android. Здесь можно скачать APK-файлы мессенджеров, навигаторов, банковских приложений и утилит. Все приложения проверены на работоспособность и совместимость с актуальными версиями Android.</p>
    <p>Для каждого приложения доступен обзор с описанием функций, скриншотами, системными требованиями, историей версий и ссылками на официальные источники.</p>
  </section>

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AppsGames.ru',
      url: 'https://appsgames.ru/',
      inLanguage: 'ru-RU',
      publisher: {
        '@type': 'Organization',
        name: 'AppsGames.ru',
        url: 'https://appsgames.ru/',
      },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://appsgames.ru/?s={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    })}
  />
</BaseLayout>

<style>
  .home-cats {
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }
  @media (min-width: 640px) {
    .cats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cat-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 0.12s ease, border-color 0.15s ease;
  }
  .cat-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    text-decoration: none;
  }
  .cat-card__icon {
    font-size: 1.5rem;
  }
  .cat-card__name {
    font-weight: 600;
    font-size: 0.95rem;
    flex: 1;
  }
  .cat-card__count {
    font-size: 0.78rem;
    color: var(--fg-subtle);
    background: var(--bg-soft);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .home-section {
    padding: clamp(1rem, 2vw, 1.5rem) 0;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .section-head h2 {
    margin: 0;
    font-size: 1.3rem;
  }
  .section-head__link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }

  .apps-grid {
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .apps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 960px) {
    .apps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .app-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 0.12s ease, border-color 0.15s ease;
  }
  .app-item:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border));
    text-decoration: none;
  }
  .app-item__icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .app-item__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .app-item__name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .app-item__desc {
    font-size: 0.8rem;
    color: var(--fg-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .app-item__badge {
    flex-shrink: 0;
    padding: 0.3rem 0.6rem;
    background: color-mix(in oklab, var(--accent) 12%, transparent);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 6px;
    white-space: nowrap;
  }
  .app-item__btn {
    flex-shrink: 0;
    padding: 0.4rem 0.8rem;
    background: var(--accent);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    border-radius: 6px;
  }

  .home-text {
    padding: clamp(2rem, 3vw, 3rem) 0;
  }
  .home-text h2 {
    font-size: 1.2rem;
    margin: 0 0 0.8rem;
  }
  .home-text p {
    color: var(--fg-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.8rem;
  }
</style>
