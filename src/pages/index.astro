---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleMedia from '../components/ArticleMedia.astro';
import { resolveCategory, resolveCategoryLabel } from '../lib/hero.ts';

const FORMAT_LABELS: Record<string, string> = {
  news: 'Новость',
  howto: 'Инструкция',
  review: 'Обзор',
  explainer: 'Разбор',
  roundup: 'Подборка',
};

const title = 'AppsGames.ru — обзоры, инструкции и новости для iPhone и Android';
const description =
  'Обзоры приложений, понятные инструкции и свежие новости про iOS и Android. Проверено на актуальных версиях, пишем как для себя.';

type Frontmatter = {
  title: string;
  description?: string;
  pubDate: string | Date;
  category?: string;
  format?: string;
  hero?: string;
  heroAlt?: string;
  readingTime?: number;
};

const modules = import.meta.glob<{
  frontmatter: Frontmatter;
  url?: string;
}>('./**/*.mdx', { eager: true });

type Article = Frontmatter & {
  url: string;
  pubDate: Date;
  categorySlug: ReturnType<typeof resolveCategory>;
  categoryLabel: string;
};

const all: Article[] = Object.entries(modules)
  .map(([file, m]) => {
    const fm = m.frontmatter;
    const url =
      m.url ??
      '/' + file.replace(/^\.\//, '').replace(/\/index\.mdx$/, '/').replace(/\.mdx$/, '/');
    const pubDate = new Date(fm.pubDate ?? '2026-01-01');
    const baseSlug = resolveCategory(url);
    // Выделяем /novosti/ в отдельный цветной слот — в hero.ts его нет.
    const categorySlug = url.startsWith('/novosti/') ? ('novosti' as unknown as typeof baseSlug) : baseSlug;
    // label берём из формата (если новость) → "Новость/Инструкция/Обзор",
    // иначе — по разделу URL. Это даёт согласованный цветной бейдж.
    const fmtLabel = fm.format ? FORMAT_LABELS[fm.format] : undefined;
    const categoryLabel = fmtLabel ?? (url.startsWith('/novosti/') ? 'Новости' : resolveCategoryLabel(baseSlug));
    return {
      ...fm,
      url,
      pubDate,
      categorySlug,
      categoryLabel,
      fileKey: file,
    };
  })
  // Стабильная сортировка: сначала по дате (desc), потом по имени файла (desc) —
  // для новостей, у которых одинаковый pubDate, свежая дата в slug даст корректный порядок.
  .sort((a, b) => {
    const dt = b.pubDate.getTime() - a.pubDate.getTime();
    if (dt !== 0) return dt;
    return (b.fileKey ?? '').localeCompare(a.fileKey ?? '');
  });

// Hero — самая свежая новость (формат news); если новостей нет — любая свежая.
const news = all.filter((a) => a.format === 'news' || a.categorySlug === ('novosti' as unknown));
const newsByUrl = all.filter((a) => a.url.startsWith('/novosti/'));
const heroCandidate = newsByUrl[0] ?? all[0];
const hero = heroCandidate;
const heroUrls = new Set([hero?.url]);
const subHero = newsByUrl.filter((a) => !heroUrls.has(a.url)).slice(0, 3);
subHero.forEach((a) => heroUrls.add(a.url));
// Если новостей не хватает — добиваем свежими обзорами/советами.
while (subHero.length < 3) {
  const next = all.find((a) => !heroUrls.has(a.url));
  if (!next) break;
  subHero.push(next);
  heroUrls.add(next.url);
}
// Round-robin по категориям + приоритет статьям с реальным hero-фото —
// так на главной нет длинных одноцветных блоков и нет пустых SVG-обложек,
// когда рядом есть статья с AI-картинкой.
const FEED_LIMIT = 10;
const feedPool = all.filter((a) => !heroUrls.has(a.url));
const feedCatOrder: Array<Article['categorySlug'] | 'novosti'> = [
  'ios',
  'android',
  'obzory',
  'sovety',
  'bezopasnost',
] as unknown as Array<Article['categorySlug']>;
const byCat = new Map<string, Article[]>();
for (const a of feedPool) {
  const key = String(a.categorySlug);
  if (!byCat.has(key)) byCat.set(key, []);
  byCat.get(key)!.push(a);
}
for (const list of byCat.values()) {
  list.sort((a, b) => {
    // в каждой категории — сначала с реальным hero, потом по имени файла desc
    const ha = a.hero ? 0 : 1;
    const hb = b.hero ? 0 : 1;
    if (ha !== hb) return ha - hb;
    return (b.fileKey ?? '').localeCompare(a.fileKey ?? '');
  });
}
const feed: Article[] = [];
const seen = new Set<string>();
let safety = 0;
while (feed.length < FEED_LIMIT && safety++ < 200) {
  let progressed = false;
  for (const cat of feedCatOrder) {
    if (feed.length >= FEED_LIMIT) break;
    const list = byCat.get(String(cat));
    if (!list || list.length === 0) continue;
    const next = list.shift()!;
    if (seen.has(next.url)) continue;
    seen.add(next.url);
    feed.push(next);
    progressed = true;
  }
  if (!progressed) break;
}
// Если категорий не хватило — добираем остальные
if (feed.length < FEED_LIMIT) {
  for (const a of feedPool) {
    if (feed.length >= FEED_LIMIT) break;
    if (seen.has(a.url)) continue;
    seen.add(a.url);
    feed.push(a);
  }
}

// "Популярное" — ручной отбор cornerstone-контента (не завязан на pubDate)
const popularHrefs = [
  '/obzory/luchshie-messenzhery-2026/',
  '/bezopasnost/kak-nastroit-dvuhfaktornuyu-autentifikaciyu/',
  '/obzory/menedzhery-parolei/',
  '/sovety/kak-sehkonomit-batareyu-iphone/',
  '/obzory/luchshie-vpn-iphone/',
];
const byUrl = new Map(all.map((a) => [a.url, a] as const));
const popular = popularHrefs
  .map((h) => byUrl.get(h))
  .filter((a): a is Article => !!a);

// Cornerstone — "Начать с этого", большие карточки
const cornerstoneHrefs = [
  '/ios/kak-sdelat/perenesti-dannyie-na-novyi-iphone/',
  '/android/kak-sdelat/sbros-nastroek-android/',
  '/bezopasnost/kak-nastroit-dvuhfaktornuyu-autentifikaciyu/',
  '/obzory/luchshie-messenzhery-2026/',
];
const cornerstone = cornerstoneHrefs
  .map((h) => byUrl.get(h))
  .filter((a): a is Article => !!a);

const categories = [
  { href: '/ios/', label: 'iOS', desc: 'iPhone, iPad', slug: 'ios' },
  { href: '/android/', label: 'Android', desc: 'Настройка, приложения', slug: 'android' },
  { href: '/novosti/', label: 'Новости', desc: 'Что случилось', slug: 'novosti' },
  { href: '/obzory/', label: 'Обзоры', desc: 'Подборки, сравнения', slug: 'obzory' },
  { href: '/sovety/', label: 'Советы', desc: 'Экономят время', slug: 'sovety' },
  { href: '/bezopasnost/', label: 'Безопасность', desc: '2FA, приватность', slug: 'bezopasnost' },
];

const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long' });
---

<BaseLayout title={title} description={description}>
  {hero && (
    <section class="home-hero container">
      <div class="hh-grid">
        <a class="hh-main" href={hero.url}>
          <div class="hh-main__media">
            <ArticleMedia
              url={hero.url}
              title={hero.title}
              hero={hero.hero}
              heroAlt={hero.heroAlt}
              categoryLabel={hero.categoryLabel}
              variant="hero"
              eager
              aspectRatio="16/9"
            />
            <span class={`chip chip--${hero.categorySlug}`}>{hero.categoryLabel}</span>
          </div>
          <div class="hh-main__body">
            <h1 class="hh-main__title">{hero.title}</h1>
            {hero.description && <p class="hh-main__desc">{hero.description}</p>}
            <p class="hh-main__meta">
              <time datetime={hero.pubDate.toISOString()}>{fmt.format(hero.pubDate)}</time>
              {hero.readingTime && <span> · {hero.readingTime} мин чтения</span>}
            </p>
          </div>
        </a>

        <ul class="hh-side">
          {subHero.map((a) => (
            <li>
              <a href={a.url} class="hh-side__item">
                <div class="hh-side__media">
                  <ArticleMedia
                    url={a.url}
                    title={a.title}
                    hero={a.hero}
                    heroAlt={a.heroAlt}
                    categoryLabel={a.categoryLabel}
                    variant="card"
                    aspectRatio="16/9"
                  />
                </div>
                <div class="hh-side__body">
                  <span class={`chip chip--${a.categorySlug} chip--sm`}>{a.categoryLabel}</span>
                  <h3>{a.title}</h3>
                  <time datetime={a.pubDate.toISOString()}>{fmt.format(a.pubDate)}</time>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="home-cats container">
    <ul class="cats">
      {categories.map((c) => (
        <li class={`cats__item cats__item--${c.slug}`}>
          <a href={c.href}>
            <span class="cats__icon" aria-hidden="true">
              {c.slug === 'ios' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.56c.02-2.2 1.8-3.27 1.88-3.32-1.03-1.5-2.62-1.71-3.19-1.74-1.36-.14-2.65.8-3.34.8-.69 0-1.74-.78-2.87-.76-1.48.02-2.85.86-3.6 2.18-1.54 2.66-.39 6.59 1.1 8.75.74 1.06 1.62 2.25 2.77 2.21 1.12-.05 1.54-.72 2.89-.72s1.73.72 2.91.7c1.2-.02 1.96-1.07 2.69-2.13.85-1.22 1.2-2.4 1.22-2.46-.03-.01-2.34-.9-2.36-3.56zM14.1 5.86c.6-.73 1-1.73.9-2.73-.86.04-1.92.58-2.54 1.3-.55.64-1.04 1.68-.91 2.65.97.07 1.95-.49 2.55-1.22z"/></svg>
              )}
              {c.slug === 'android' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 10v6a1 1 0 1 0 2 0v-6a1 1 0 1 0-2 0zm11-3c.5 0 1-.4 1-1V3.5a.5.5 0 0 0-1 0V6a8 8 0 0 0-2.5-1.5l.97-1.7a.4.4 0 0 0-.69-.4L13.8 4.2A7.98 7.98 0 0 0 12 4c-.64 0-1.25.08-1.83.22L9.2 2.4a.4.4 0 0 0-.69.4l.97 1.7A8 8 0 0 0 7 6V3.5a.5.5 0 0 0-1 0V6c0 .6.5 1 1 1h10zM8 18v2a1 1 0 1 0 2 0v-2h4v2a1 1 0 1 0 2 0v-2h1V9H7v9h1zm8-8a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm-8 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm10 0v6a1 1 0 1 0 2 0v-6a1 1 0 1 0-2 0z"/></svg>
              )}
              {c.slug === 'novosti' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10l4-4V6a2 2 0 0 0-2-2zm-2 12h-3v3l-1-1H5V6h14v10h-2zM7 9h10v2H7V9zm0 4h7v2H7v-2z"/></svg>
              )}
              {c.slug === 'obzory' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.3L22 9.3l-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 7.1-1z"/></svg>
              )}
              {c.slug === 'sovety' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 21h6v1a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1v-1zm3-19a7 7 0 0 0-4.2 12.6V17c0 .6.4 1 1 1h6.4c.6 0 1-.4 1-1v-2.4A7 7 0 0 0 12 2z"/></svg>
              )}
              {c.slug === 'bezopasnost' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1 14-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6z"/></svg>
              )}
            </span>
            <span class="cats__txt">
              <span class="cats__label">{c.label}</span>
              <span class="cats__desc">{c.desc}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="home-main container">
    <div class="hm-grid">
      <div class="hm-feed">
        <header class="hm-head">
          <h2>Свежее</h2>
          <a href="/novosti/" class="hm-head__link">Все новости →</a>
        </header>

        <ul class="feed">
          {feed.map((a) => (
            <li class="feed__item">
              <a href={a.url}>
                <div class="feed__media">
                  <ArticleMedia
                    url={a.url}
                    title={a.title}
                    hero={a.hero}
                    heroAlt={a.heroAlt}
                    categoryLabel={a.categoryLabel}
                    variant="card"
                    aspectRatio="16/10"
                  />
                </div>
                <div class="feed__body">
                  <span class={`chip chip--${a.categorySlug} chip--sm`}>{a.categoryLabel}</span>
                  <h3>{a.title}</h3>
                  {a.description && <p>{a.description}</p>}
                  <p class="feed__meta">
                    <time datetime={a.pubDate.toISOString()}>{fmt.format(a.pubDate)}</time>
                    {a.readingTime && <span> · {a.readingTime} мин</span>}
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <aside class="hm-side">
        <section class="side-card">
          <h3 class="side-card__title">Популярное</h3>
          <ol class="pop">
            {popular.map((a, idx) => (
              <li class="pop__item">
                <a href={a.url}>
                  <span class="pop__num" aria-hidden="true">{String(idx + 1).padStart(2, '0')}</span>
                  <span class="pop__ttl">
                    <span class={`chip chip--${a.categorySlug} chip--xs`}>{a.categoryLabel}</span>
                    <span class="pop__h">{a.title}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>

        <section class="side-card side-card--tg">
          <h3 class="side-card__title">О проекте</h3>
          <p>
            AppsGames — это без воды о смартфонах, приложениях и цифровой безопасности. Новые
            материалы 5–7 раз в неделю, проверено на актуальных версиях iOS и Android.
          </p>
          <a href="/o-proekte/" class="side-card__cta">Подробнее →</a>
        </section>
      </aside>
    </div>
  </section>

  {cornerstone.length > 0 && (
    <section class="home-corner container">
      <header class="hm-head">
        <h2>Начать с этого</h2>
        <p class="hm-head__sub">Ключевые материалы, которые пригодятся каждому</p>
      </header>
      <ul class="corner">
        {cornerstone.map((a) => (
          <li class="corner__item">
            <a href={a.url}>
              <div class="corner__media">
                <ArticleMedia
                  url={a.url}
                  title={a.title}
                  hero={a.hero}
                  heroAlt={a.heroAlt}
                  categoryLabel={a.categoryLabel}
                  variant="card"
                  aspectRatio="4/3"
                />
              </div>
              <div class="corner__body">
                <span class={`chip chip--${a.categorySlug} chip--sm`}>{a.categoryLabel}</span>
                <h3>{a.title}</h3>
                {a.description && <p>{a.description}</p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'AppsGames.ru',
      url: 'https://appsgames.ru/',
      inLanguage: 'ru-RU',
      publisher: {
        '@type': 'Organization',
        name: 'AppsGames.ru',
        url: 'https://appsgames.ru/',
      },
    })}
  />
</BaseLayout>

<style>
  /* ---------- chip ---------- */
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1;
    background: var(--bg-soft);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .chip--sm {
    padding: 0.24rem 0.55rem;
    font-size: 0.66rem;
  }
  .chip--xs {
    padding: 0.18rem 0.45rem;
    font-size: 0.6rem;
  }
  .chip--ios {
    color: #0a7cff;
    background: color-mix(in oklab, #0a7cff 10%, transparent);
    border-color: color-mix(in oklab, #0a7cff 30%, var(--border));
  }
  .chip--android {
    color: #0f8a4a;
    background: color-mix(in oklab, #0f8a4a 12%, transparent);
    border-color: color-mix(in oklab, #0f8a4a 30%, var(--border));
  }
  .chip--novosti {
    color: #b2570e;
    background: color-mix(in oklab, #f08a2b 14%, transparent);
    border-color: color-mix(in oklab, #f08a2b 35%, var(--border));
  }
  .chip--obzory {
    color: #9a4712;
    background: color-mix(in oklab, #e67e22 14%, transparent);
    border-color: color-mix(in oklab, #e67e22 32%, var(--border));
  }
  .chip--sovety {
    color: #0f7988;
    background: color-mix(in oklab, #0aa5bc 12%, transparent);
    border-color: color-mix(in oklab, #0aa5bc 32%, var(--border));
  }
  .chip--bezopasnost {
    color: #a1202b;
    background: color-mix(in oklab, #dc3545 12%, transparent);
    border-color: color-mix(in oklab, #dc3545 32%, var(--border));
  }
  .chip--default {
    color: var(--accent);
  }
  :root[data-theme='dark'] .chip--ios,
  :root:not([data-theme='light']) .chip--ios {
    color: #6fb8ff;
  }
  :root[data-theme='dark'] .chip--android,
  :root:not([data-theme='light']) .chip--android {
    color: #6bd399;
  }
  :root[data-theme='dark'] .chip--novosti,
  :root:not([data-theme='light']) .chip--novosti {
    color: #f5ae6e;
  }
  :root[data-theme='dark'] .chip--obzory,
  :root:not([data-theme='light']) .chip--obzory {
    color: #f0a55c;
  }
  :root[data-theme='dark'] .chip--sovety,
  :root:not([data-theme='light']) .chip--sovety {
    color: #6cd7e6;
  }
  :root[data-theme='dark'] .chip--bezopasnost,
  :root:not([data-theme='light']) .chip--bezopasnost {
    color: #ff8a93;
  }

  /* ---------- hero section ---------- */
  .home-hero {
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(1.5rem, 2.5vw, 2rem);
  }
  .hh-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 960px) {
    .hh-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .hh-main {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .hh-main:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
    box-shadow: var(--shadow);
  }
  .hh-main__media {
    position: relative;
  }
  .hh-main__media .chip {
    position: absolute;
    top: 1rem;
    left: 1rem;
    backdrop-filter: blur(6px);
    background: rgba(255, 255, 255, 0.86);
    border-color: transparent;
  }
  :root[data-theme='dark'] .hh-main__media .chip,
  :root:not([data-theme='light']) .hh-main__media .chip {
    background: rgba(20, 24, 34, 0.75);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.1);
  }
  .hh-main__body {
    padding: clamp(1.2rem, 2vw, 1.8rem);
  }
  .hh-main__title {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.1rem + 1.6vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem;
  }
  .hh-main__desc {
    margin: 0 0 0.75rem;
    color: var(--fg-muted);
    font-size: var(--fs-lg);
    max-width: 62ch;
  }
  .hh-main__meta {
    margin: 0;
    font-size: 0.85rem;
    color: var(--fg-subtle);
  }

  .hh-side {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 480px) and (max-width: 959.9px) {
    .hh-side {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .hh-side__item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 0.85rem;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-card);
    color: inherit;
    text-decoration: none;
    height: 100%;
    transition: transform 0.15s ease, border-color 0.2s ease;
  }
  @media (min-width: 480px) and (max-width: 959.9px) {
    .hh-side__item {
      grid-template-columns: 1fr;
    }
  }
  .hh-side__item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--border));
  }
  .hh-side__media {
