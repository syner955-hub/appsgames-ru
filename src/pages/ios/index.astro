---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'iOS: гайды, советы и обзоры приложений для iPhone и iPad';
const description =
  'Собрали главные инструкции и обзоры приложений для iPhone и iPad: настройки, синхронизация, восстановление, эмуляторы, подключение к технике. Проверено на актуальной версии iOS.';

const sections = [
  {
    title: 'Как сделать',
    items: [
      {
        href: '/ios/kak-sdelat/skachat-muzyku-iphone/',
        title: 'Как скачать музыку на iPhone',
        desc: 'Все рабочие способы: Apple Music, синхронизация через Apple Devices и Finder, облако + плеер.',
      },
      {
        href: '/ios/kak-sdelat/sinhronizaciya-iphone-pc/',
        title: 'Как синхронизировать iPhone с компьютером',
        desc: 'Windows через Apple Devices, Mac через Finder, Wi-Fi-синхронизация и облако — без iTunes.',
      },
      {
        href: '/ios/kak-sdelat/zakachat-film-na-iphone/',
        title: 'Как закачать фильм на iPhone или iPad',
        desc: 'Через VLC, Infuse, «Файлы», AirDrop и Wi-Fi. Какие форматы поддерживаются, где споткнётесь.',
      },
      {
        href: '/poleznoe-ios/kak-nastroit-iphone/',
        title: 'Как настроить iPhone после покупки',
        desc: 'Apple ID, перенос данных, Face ID, двухфакторка, экономия батареи — чек-лист «первого часа».',
      },
      {
        href: '/uroki-po-ios/kak-sbrosit-iphone-do-zavodskikh-nastroek/',
        title: 'Как сбросить iPhone до заводских настроек',
        desc: 'Полный и мягкий сброс, бэкап перед сбросом, восстановление и подготовка к продаже.',
      },
      {
        href: '/poleznoe-ios/podklyuchit-ajjfon-k-televizoru/',
        title: 'Как подключить iPhone к телевизору',
        desc: 'AirPlay, HDMI-адаптер и DLNA. Что выбрать для Samsung, LG, Xiaomi, Apple TV.',
      },
      {
        href: '/ios/kak-sdelat/udalit-prilozhenie-iphone/',
        title: 'Как удалить приложение с iPhone',
        desc: 'Три способа: длинное нажатие, через «Настройки» с освобождением места, из «Библиотеки приложений».',
      },
      {
        href: '/ios/kak-sdelat/ochistit-kesh-iphone/',
        title: 'Как очистить кеш на iPhone',
        desc: 'Safari, Telegram, WhatsApp, системные «Другое» — что реально освобождает память, что делает хуже.',
      },
      {
        href: '/ios/kak-sdelat/skryt-foto-iphone/',
        title: 'Как скрыть фото на iPhone',
        desc: 'Папка «Скрытые» с Face ID, заметки под паролем, сторонние хранилища. Где действительно надёжно.',
      },
      {
        href: '/ios/kak-sdelat/vosstanovit-udalennyie-foto-iphone/',
        title: 'Как восстановить удалённые фото iPhone',
        desc: '«Недавно удалённые», бэкап iCloud и локальный, iCloud.com и сторонние утилиты восстановления.',
      },
      {
        href: '/ios/kak-sdelat/perenesti-dannyie-na-novyi-iphone/',
        title: 'Как перенести данные на новый iPhone',
        desc: 'Быстрое начало по кабелю и Wi-Fi, iCloud-бэкап, локальный бэкап. WhatsApp и Telegram отдельно.',
      },
      {
        href: '/ios/kak-sdelat/obnovit-ios/',
        title: 'Как обновить iOS',
        desc: 'По воздуху и через компьютер, что делать при зависании, откат и когда стоит подождать.',
      },
    ],
  },
  {
    title: 'Решение проблем',
    items: [
      {
        href: '/ios/kak-sdelat/ipad-ne-vklyuchaetsya/',
        title: 'iPad не включается: что делать',
        desc: 'Проверка зарядки, hard reset, режим восстановления и DFU — по шагам, от простого к сложному.',
      },
      {
        href: '/poleznoe-ios/dfu-rejim-iphone-ipad/',
        title: 'DFU-режим на iPhone и iPad',
        desc: 'Отличие от Recovery Mode, пошаговый вход для всех моделей, типичные ошибки и как выйти.',
      },
      {
        href: '/poleznoe-ios/vosstanavlivit-parol-ot-apple-id/',
        title: 'Как восстановить пароль от Apple ID',
        desc: 'Три официальных способа: с доверенного устройства, через iforgot.apple.com и службу поддержки.',
      },
    ],
  },
  {
    title: 'Программы',
    items: [
      {
        href: '/dopolnitelnyjj-soft/ehmulyator-ios-ipad/',
        title: 'Эмулятор iOS для Windows и Mac',
        desc: 'Что реально работает вместо эмулятора iPhone: Xcode Simulator, Appetize.io, BrowserStack.',
      },
      {
        href: '/obzory/alternativy-itunes/',
        title: 'Альтернативы iTunes в 2026',
        desc: 'iMazing, 3uTools, CopyTrans, AltStore: чем заменить iTunes для бэкапов и синхронизации.',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>iOS</h1>
      <p class="hub__lead">
        Инструкции и обзоры для iPhone и iPad. Каждую проверяем на актуальной
        версии iOS и обновляем, когда выходит новая.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="hub__group">
        <h2>{sec.title}</h2>
        <ul class="hub__list">
          {sec.items.map((a) => (
            <li class="hub__item">
              <a href={a.href}>
                <h3>{a.title}</h3>
                <p class="hub__desc">{a.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head {
    margin-bottom: 2.5rem;
  }
  .hub__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead {
    margin: 0;
    font-size: 1.1rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .hub__group {
    margin-top: 2.5rem;
  }
  .hub__group > h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    font-weight: 700;
    margin: 0 0 1.1rem;
  }
  .hub__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .hub__item a {
    display: block;
    padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .hub__desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
</style>
