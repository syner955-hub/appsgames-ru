---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'iOS — обзоры и инструкции для iPhone и iPad';
const description =
  'Раздел про iOS на AppsGames.ru: пошаговые инструкции для iPhone и iPad, обзоры приложений, советы по настройке и решение типичных проблем.';

const articles = [
  {
    href: '/ios/kak-sdelat/skachat-muzyku-iphone/',
    title: 'Как скачать музыку на iPhone в 2026',
    description:
      'Все рабочие способы: Apple Music, синхронизация с Mac и Windows через Apple Devices, облако + плеер.',
    tag: 'Как сделать',
  },
];

const planned = [
  'Как сбросить iPhone до заводских настроек',
  'DFU-режим iPhone и iPad: как войти и зачем',
  'Как восстановить пароль от Apple ID',
  'Как настроить iPhone после покупки',
  'Альтернативы iTunes в 2026',
];
---

<BaseLayout title={title} description={description} noindex>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>iOS</h1>
      <p class="hub__lead">
        Инструкции и обзоры для iPhone и iPad. Каждую инструкцию мы проверяем
        на актуальной версии iOS и указываем дату последнего обновления.
      </p>
    </header>

    <section class="hub__group">
      <h2>Свежие материалы</h2>
      <ul class="hub__list">
        {articles.map((a) => (
          <li class="hub__item">
            <a href={a.href}>
              <p class="hub__tag">{a.tag}</p>
              <h3>{a.title}</h3>
              <p class="hub__desc">{a.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="hub__group">
      <h2>Скоро</h2>
      <ul class="hub__planned">
        {planned.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head {
    margin-bottom: 2.5rem;
  }
  .hub__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead {
    margin: 0;
    font-size: 1.1rem;
    color: var(--fg-muted);
    max-width: 60ch;
  }
  .hub__group {
    margin-top: 2rem;
  }
  .hub__group > h2 {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-subtle);
    font-weight: 700;
    margin: 0 0 1.1rem;
  }
  .hub__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  .hub__item a {
    display: block;
    padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    text-decoration: none;
    color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__tag {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem;
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.3;
  }
  .hub__desc {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .hub__planned {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--fg-muted);
  }
  .hub__planned li {
    margin-bottom: 0.3rem;
  }
</style>
