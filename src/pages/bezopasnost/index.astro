---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubStub from '../../components/HubStub.astro';

const title = 'Безопасность смартфона и приложений — AppsGames.ru';
const description =
  'Раздел про безопасность iOS и Android: двухфакторная аутентификация, менеджеры паролей, проверка приложений, защита от слежки.';
---

<BaseLayout title={title} description={description} noindex>
  <HubStub
    eyebrow="Раздел"
    title="Безопасность"
    lead="Готовим материалы про безопасность смартфонов: двухфакторная аутентификация, менеджеры паролей, проверка приложений и что делать при утечках."
    planned={[
      'Как включить двухфакторную аутентификацию правильно',
      'Менеджеры паролей: почему пора перестать запоминать',
      'Как проверить, что приложение не сливает данные',
      'Что делать, если ваши данные утекли',
      'Фишинг в SMS и Telegram: как не попасться',
    ]}
  />
</BaseLayout>
