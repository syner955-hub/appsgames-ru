---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Безопасность и приватность на смартфоне';
const description =
  'Как защитить телефон от взлома, утечек и слежки: проверка APK, восстановление доступа, надёжные источники приложений, безопасные настройки iOS и Android.';

const sections = [
  {
    title: 'Аутентификация и пароли',
    items: [
      {
        href: '/bezopasnost/kak-nastroit-dvuhfaktornuyu-autentifikaciyu/',
        title: 'Как настроить двухфакторную аутентификацию',
        desc: '2FA для Apple ID, Google, банков, мессенджеров. Что выбрать и как делать бэкап кодов.',
      },
      {
        href: '/poleznoe-ios/vosstanavlivit-parol-ot-apple-id/',
        title: 'Как восстановить пароль от Apple ID',
        desc: 'Три официальных способа, что делать, если забыли и почту, и включён ключ восстановления.',
      },
      {
        href: '/obzory/menedzhery-parolei/',
        title: 'Лучшие менеджеры паролей',
        desc: '1Password, Bitwarden, iCloud Keychain, Proton Pass. Что выбрать и как перейти.',
      },
    ],
  },
  {
    title: 'Вирусы и утечки',
    items: [
      {
        href: '/bezopasnost/kak-proverit-prilozhenie-na-virus/',
        title: 'Как проверить приложение на вирус',
        desc: 'VirusTotal, Play Protect, Bitdefender. Признаки заражения и что делать, если поймали.',
      },
      {
        href: '/bezopasnost/chto-delat-esli-dannye-uteklii/',
        title: 'Что делать, если данные утекли',
        desc: 'Проверяем на haveibeenpwned, меняем пароли, включаем 2FA, защищаем карты и паспорт.',
      },
      {
        href: '/bezopasnost/bezopasno-skachat-apk-android/',
        title: 'Как безопасно скачать APK на Android',
        desc: 'Где брать APK, как проверить через VirusTotal, на какие разрешения смотреть.',
      },
    ],
  },
  {
    title: 'Защита устройства',
    items: [
      {
        href: '/poleznoe-dlya-android/udalennoe-upravlenie-ustrojjstvami-na-android/',
        title: 'Удалённое управление Android',
        desc: 'Google Find My Device, Samsung, Xiaomi, Huawei: как найти, заблокировать и стереть смартфон.',
      },
      {
        href: '/ios/kak-sdelat/skryt-foto-iphone/',
        title: 'Как скрыть фото на iPhone',
        desc: '«Скрытые» с Face ID, заметки под паролем, сторонние хранилища. Где действительно надёжно.',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>Безопасность</h1>
      <p class="hub__lead">
        Практическая безопасность для обычных пользователей: что делать до и
        после того, как что-то пошло не так. Без паранойи, но и без наивности.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="hub__group">
        <h2>{sec.title}</h2>
        <ul class="hub__list">
          {sec.items.map((a) => (
            <li class="hub__item">
              <a href={a.href}>
                <h3>{a.title}</h3>
                <p class="hub__desc">{a.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head { margin-bottom: 2.5rem; }
  .hub__eyebrow {
    margin: 0 0 0.4rem; font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem; font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead { margin: 0; font-size: 1.1rem; color: var(--fg-muted); max-width: 60ch; }
  .hub__group { margin-top: 2.5rem; }
  .hub__group > h2 {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--fg-subtle); font-weight: 700; margin: 0 0 1.1rem;
  }
  .hub__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .hub__item a {
    display: block; padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); text-decoration: none; color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem; font-family: var(--font-serif);
    font-size: 1.2rem; line-height: 1.3;
  }
  .hub__desc { margin: 0; color: var(--fg-muted); font-size: 0.95rem; }
</style>
