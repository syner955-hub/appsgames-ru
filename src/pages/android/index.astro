---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Android: гайды, обзоры и настройки смартфона';
const description =
  'Инструкции, обзоры приложений и советы по настройке Android: от установки APK и альтернатив Google Play до синхронизации с ПК и замены экрана.';

const sections = [
  {
    title: 'Как сделать',
    items: [
      {
        href: '/android/kak-sdelat/sinhronizaciya-android-pc/',
        title: 'Как синхронизировать Android с компьютером',
        desc: 'Phone Link, MTP по USB, Android File Transfer, KDE Connect и облако Google — по задачам.',
      },
      {
        href: '/android/kak-sdelat/ustanovit-apk-android/',
        title: 'Как установить APK-файл на Android',
        desc: 'Разрешаем установку из неизвестных источников, проверяем через VirusTotal, ставим пошагово.',
      },
      {
        href: '/android/kak-sdelat/skachat-prilozhenie-ne-iz-google-play/',
        title: 'Как скачать приложение мимо Google Play',
        desc: 'RuStore, APKMirror, F-Droid, Huawei AppGallery. Где безопасно, где — нет и почему.',
      },
    ],
  },
  {
    title: 'Сервис и ремонт',
    items: [
      {
        href: '/android/kak-sdelat/zamena-ehkrana-smartfona/',
        title: 'Замена экрана смартфона: цены 2026',
        desc: 'Реальные цены по моделям, чем отличается оригинал от копии, стоит ли менять самому.',
      },
      {
        href: '/poleznoe-dlya-android/udalennoe-upravlenie-ustrojjstvami-na-android/',
        title: 'Удалённое управление Android',
        desc: 'Находим, блокируем, стираем потерянный смартфон через Find My Device, Samsung, Xiaomi.',
      },
    ],
  },
  {
    title: 'Программы',
    items: [
      {
        href: '/dopolnitelnyjj-soft/ehmulyator-android/',
        title: 'Эмулятор Android для PC и Mac: топ-6',
        desc: 'BlueStacks, LDPlayer, Google Play Games, Android Studio — для игр, разработки, тестирования.',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>Android</h1>
      <p class="hub__lead">
        Как жить с Android в 2026: от первой установки APK до дистанционного
        поиска утерянного смартфона. Без воды и с актуальными скринами.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="hub__group">
        <h2>{sec.title}</h2>
        <ul class="hub__list">
          {sec.items.map((a) => (
            <li class="hub__item">
              <a href={a.href}>
                <h3>{a.title}</h3>
                <p class="hub__desc">{a.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head { margin-bottom: 2.5rem; }
  .hub__eyebrow {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem;
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead { margin: 0; font-size: 1.1rem; color: var(--fg-muted); max-width: 60ch; }
  .hub__group { margin-top: 2.5rem; }
  .hub__group > h2 {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--fg-subtle); font-weight: 700; margin: 0 0 1.1rem;
  }
  .hub__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .hub__item a {
    display: block; padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); text-decoration: none; color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem; font-family: var(--font-serif);
    font-size: 1.2rem; line-height: 1.3;
  }
  .hub__desc { margin: 0; color: var(--fg-muted); font-size: 0.95rem; }
</style>
