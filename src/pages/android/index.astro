---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Приложения для Android: скачать APK бесплатно';
const description = 'Каталог приложений для Android. Казино, игры, мессенджеры и утилиты. Скачивайте APK бесплатно.';
---

<BaseLayout title={title} description={description}>
  <section class="container" style="max-width: 720px; padding-top: 3rem; padding-bottom: 5rem;">
    <h1>Приложения для Android</h1>
    <ul style="list-style: none; padding: 0; display: grid; gap: 0.8rem;">
      <li><a href="/android/casino/" style="display:block; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit;">🎰 Казино на Android — 28 приложений</a></li>
      <li><a href="/apps/" style="display:block; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); text-decoration: none; color: inherit;">📱 Все приложения — 15 программ</a></li>
    </ul>
  </section>
</BaseLayout>
