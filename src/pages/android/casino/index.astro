  .hub__text p {
    color: var(--fg-muted);
    line-height: 1.6;
  }
  .hub__text ol,
  .hub__text ul {
    padding-left: 1.5rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }
  .hub__text li {
    margin-bottom: 0.4rem;
