---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Советы по работе с iPhone и Android';
const description =
  'Практические советы, которые экономят время и батарею. Настройки, лайфхаки, разбор частых ошибок для iOS и Android.';

const sections = [
  {
    title: 'Экономия и производительность',
    items: [
      {
        href: '/sovety/kak-sehkonomit-batareyu-iphone/',
        title: 'Как сэкономить батарею iPhone',
        desc: '15 рабочих настроек: яркость, 5G, Background App Refresh, Always-On. Без мифов про свайпы.',
      },
      {
        href: '/sovety/kak-uskorit-android/',
        title: 'Как ускорить Android',
        desc: 'Чистим память, удаляем bloatware, отключаем анимации. Что реально работает, а что миф.',
      },
      {
        href: '/sovety/kak-umenshit-trafik-na-telefone/',
        title: 'Как уменьшить мобильный трафик',
        desc: 'Настраиваем соцсети, мессенджеры, YouTube, облака — чтобы пакет доживал до конца месяца.',
      },
      {
        href: '/sovety/osvobodit-mesto-na-iphone/',
        title: 'Как освободить место на iPhone',
        desc: 'Пошагово очищаем 10–50 ГБ: фото, кеш, тяжёлые приложения и загадочное «Другое».',
      },
    ],
  },
  {
    title: 'Контроль расходов',
    items: [
      {
        href: '/sovety/upravlyat-podpiskami-app-store/',
        title: 'Как управлять подписками App Store',
        desc: 'Смотрим, отменяем, возвращаем деньги. Семейный доступ и нюансы российских карт.',
      },
    ],
  },
  {
    title: 'Настройка и синхронизация',
    items: [
      {
        href: '/poleznoe-ios/kak-nastroit-iphone/',
        title: 'Как настроить iPhone после покупки',
        desc: 'Чек-лист первого часа: Apple ID, Face ID, iCloud, батарея, безопасность. За 30 минут.',
      },
      {
        href: '/android/kak-sdelat/sinhronizaciya-android-pc/',
        title: 'Как синхронизировать Android с компьютером',
        desc: 'Phone Link, Android File Transfer, облако и KDE Connect — выбираем способ под задачу.',
      },
      {
        href: '/ios/kak-sdelat/sinhronizaciya-iphone-pc/',
        title: 'Как синхронизировать iPhone с компьютером',
        desc: 'Apple Devices на Windows, Finder на Mac, Wi-Fi и облако. Что куда идёт.',
      },
      {
        href: '/poleznoe-ios/podklyuchit-ajjfon-k-televizoru/',
        title: 'Как подключить iPhone к телевизору',
        desc: 'AirPlay, HDMI-переходник и DLNA — без лишнего софта и провалов.',
      },
      {
        href: '/android/kak-sdelat/skachat-prilozhenie-ne-iz-google-play/',
        title: 'Как скачать приложение мимо Google Play',
        desc: 'Безопасные альтернативы: RuStore, APKMirror, F-Droid, Huawei AppGallery.',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>Советы</h1>
      <p class="hub__lead">
        Собрали главные практические материалы из разных разделов — те, что
        решают типичные задачи, а не перечисляют возможности.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="hub__group">
        <h2>{sec.title}</h2>
        <ul class="hub__list">
          {sec.items.map((a) => (
            <li class="hub__item">
              <a href={a.href}>
                <h3>{a.title}</h3>
                <p class="hub__desc">{a.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head { margin-bottom: 2.5rem; }
  .hub__eyebrow {
    margin: 0 0 0.4rem; font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem; font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead { margin: 0; font-size: 1.1rem; color: var(--fg-muted); max-width: 60ch; }
  .hub__group { margin-top: 2.5rem; }
  .hub__group > h2 {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--fg-subtle); font-weight: 700; margin: 0 0 1.1rem;
  }
  .hub__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .hub__item a {
    display: block; padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); text-decoration: none; color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem; font-family: var(--font-serif);
    font-size: 1.2rem; line-height: 1.3;
  }
  .hub__desc { margin: 0; color: var(--fg-muted); font-size: 0.95rem; }
</style>
