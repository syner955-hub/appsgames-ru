---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Обзоры приложений и подборки лучших сервисов';
const description =
  'Честные обзоры приложений для iOS и Android, сравнения и подборки: альтернативы iTunes, эмуляторы, программы для работы с техникой.';

const sections = [
  {
    title: 'Мессенджеры и коммуникации',
    items: [
      {
        href: '/obzory/luchshie-messenzhery-2026/',
        title: 'Лучшие мессенджеры 2026',
        desc: 'Telegram, WhatsApp, Max, Signal, Viber, Discord. Под какие сценарии что подходит.',
      },
      {
        href: '/obzory/whatsapp-vs-telegram/',
        title: 'WhatsApp vs Telegram',
        desc: 'Сравниваем по шифрованию, скорости, каналам, работе с файлами и удобству.',
      },
    ],
  },
  {
    title: 'Безопасность и приватность',
    items: [
      {
        href: '/obzory/luchshie-vpn-iphone/',
        title: 'Лучшие VPN для iPhone',
        desc: 'Proton, NordVPN, Mullvad, 1.1.1.1, Outline. Что работает в РФ и сколько стоит.',
      },
      {
        href: '/obzory/luchshie-vpn-android/',
        title: 'Лучшие VPN для Android',
        desc: 'Платные и бесплатные. Где скачать, если нет в Google Play.',
      },
      {
        href: '/obzory/luchshie-antivirusy-android/',
        title: 'Лучшие антивирусы для Android',
        desc: 'Bitdefender, Kaspersky, Malwarebytes, Dr.Web. Нужен ли антивирус вообще.',
      },
      {
        href: '/obzory/menedzhery-parolei/',
        title: 'Лучшие менеджеры паролей',
        desc: '1Password, Bitwarden, iCloud Keychain, Proton Pass. Что выбрать и как перейти.',
      },
    ],
  },
  {
    title: 'Ежедневные приложения',
    items: [
      {
        href: '/obzory/luchshie-brauzery-iphone/',
        title: 'Лучшие браузеры для iPhone',
        desc: 'Safari, Chrome, Firefox, Brave, Яндекс, DuckDuckGo. Что отличается и чем.',
      },
      {
        href: '/obzory/luchshie-prilozheniya-dlya-chteniya/',
        title: 'Лучшие приложения для чтения книг',
        desc: 'Литрес, Bookmate, Kindle, KyBook, FBReader. Подписки, форматы, экосистемы.',
      },
      {
        href: '/obzory/luchshie-prilozheniya-dlya-zametok/',
        title: 'Лучшие приложения для заметок',
        desc: 'Apple Notes, Notion, Obsidian, Bear, Google Keep, Standard Notes. Под разные задачи.',
      },
    ],
  },
  {
    title: 'Программы для iOS и Android',
    items: [
      {
        href: '/obzory/alternativy-itunes/',
        title: 'Альтернативы iTunes в 2026 году',
        desc: 'iMazing, 3uTools, CopyTrans, Apple Devices, Finder, AltStore, iExplorer — чем заменить iTunes.',
      },
      {
        href: '/dopolnitelnyjj-soft/ehmulyator-ios-ipad/',
        title: 'Эмулятор iOS: что работает, а что обман',
        desc: 'Xcode Simulator, облачные Appetize.io и BrowserStack, и почему «iPadian» — развод.',
      },
      {
        href: '/dopolnitelnyjj-soft/ehmulyator-android/',
        title: 'Эмулятор Android для PC и Mac',
        desc: 'BlueStacks, LDPlayer, NoxPlayer, MEmu, Google Play Games, Android Studio Emulator.',
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <section class="hub container">
    <header class="hub__head">
      <p class="hub__eyebrow">Раздел</p>
      <h1>Обзоры и подборки</h1>
      <p class="hub__lead">
        Честно сравниваем приложения и сервисы: функциональность, цена,
        подводные камни. Без влияния рекламодателей.
      </p>
    </header>

    {sections.map((sec) => (
      <section class="hub__group">
        <h2>{sec.title}</h2>
        <ul class="hub__list">
          {sec.items.map((a) => (
            <li class="hub__item">
              <a href={a.href}>
                <h3>{a.title}</h3>
                <p class="hub__desc">{a.desc}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>

<style>
  .hub {
    max-width: 860px;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hub__head { margin-bottom: 2.5rem; }
  .hub__eyebrow {
    margin: 0 0 0.4rem; font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent);
  }
  .hub__head h1 {
    margin: 0 0 0.7rem; font-size: clamp(2rem, 1.5rem + 2.5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hub__lead { margin: 0; font-size: 1.1rem; color: var(--fg-muted); max-width: 60ch; }
  .hub__group { margin-top: 2.5rem; }
  .hub__group > h2 {
    font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.12em;
    color: var(--fg-subtle); font-weight: 700; margin: 0 0 1.1rem;
  }
  .hub__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; }
  .hub__item a {
    display: block; padding: 1.1rem 1.25rem 1.2rem;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: var(--bg-card); text-decoration: none; color: var(--fg);
    transition: border-color 0.15s, transform 0.15s;
  }
  .hub__item a:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, var(--border));
    transform: translateY(-1px);
  }
  .hub__item h3 {
    margin: 0 0 0.4rem; font-family: var(--font-serif);
    font-size: 1.2rem; line-height: 1.3;
  }
  .hub__desc { margin: 0; color: var(--fg-muted); font-size: 0.95rem; }
</style>
