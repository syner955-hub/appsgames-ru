  { slug: 'tinkoff', name: 'Тинькофф', category: 'Финансы', desc: 'Банк с инвестициями и кэшбэком' },
  { slug: 'alfa-bank', name: 'Альфа-Банк', category: 'Финансы', desc: 'Переводы, счета, кредиты и кэшбэк' },
