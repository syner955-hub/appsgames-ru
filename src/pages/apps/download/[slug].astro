const { app } = Astro.props;
const downloadUrl = `https://d.apkpure.net/b/APK/${app.pkg}?version=latest`;
const playUrl = `https://play.google.com/store/apps/details?id=${app.pkg}`;
---

<BaseLayout title={`Скачать ${app.name} APK бесплатно на Android`} description={`Скачайте ${app.name} APK (${app.size}) бесплатно. Версия ${app.version}, Android ${app.android}.`}>
  <section class="download-page container">
    <div class="download-card">
      <img src={`/images/apps/${app.slug}.webp`} alt={app.name} width="80" height="80" class="download-card__icon" />
      <h1 class="download-card__title">Скачать {app.name}</h1>
      <p class="download-card__subtitle">APK-файл для Android</p>

      <div class="download-card__meta">
        <div class="meta-item">
          <span class="meta-label">Версия</span>
          <span class="meta-value">{app.version}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Размер</span>
          <span class="meta-value">{app.size}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Android</span>
          <span class="meta-value">{app.android}</span>
        </div>
      </div>

      <div class="download-card__timer" id="timer-block">
        <p class="timer-text">Ссылка будет готова через <span id="countdown">5</span> сек...</p>
        <div class="timer-bar"><div class="timer-bar__fill" id="timer-fill"></div></div>
      </div>

      <div class="download-card__buttons" id="buttons-block" style="display:none">
        <a href={downloadUrl} class="btn-download" id="download-link" rel="nofollow noopener" target="_blank">
          Скачать APK ({app.size})
        </a>
        <a href={playUrl} class="btn-play" rel="nofollow noopener" target="_blank">
          Открыть в Google Play
        </a>
      </div>

      <p class="download-card__note">Файл загружается с внешнего сервера. Если скачивание не началось, воспользуйтесь ссылкой на Google Play.</p>

      <a href={`/apps/${app.slug}/`} class="download-card__back">← Вернуться к обзору {app.name}</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
(function() {
  let seconds = 5;
  const countdown = document.getElementById('countdown');
  const timerFill = document.getElementById('timer-fill');
  const timerBlock = document.getElementById('timer-block');
  const buttonsBlock = document.getElementById('buttons-block');

  timerFill.style.transition = 'width 1s linear';

  const interval = setInterval(function() {
    seconds--;
    countdown.textContent = seconds;
    timerFill.style.width = ((5 - seconds) / 5 * 100) + '%';

    if (seconds <= 0) {
      clearInterval(interval);
      timerBlock.style.display = 'none';
      buttonsBlock.style.display = 'flex';
    }
  }, 1000);
})();
</script>

<style>
  .download-page {
    padding: clamp(2rem, 5vw, 4rem) 0;
    display: flex;
    justify-content: center;
  }
  .download-card {
    max-width: 480px;
    width: 100%;
    text-align: center;
    padding: 2.5rem 2rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
  }
  .download-card__icon {
    width: 80px;
    height: 80px;
    border-radius: 18px;
    margin: 0 auto 1.2rem;
    display: block;
  }
  .download-card__title {
    margin: 0 0 0.3rem;
    font-size: 1.5rem;
  }
  .download-card__subtitle {
    margin: 0 0 1.5rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }
  .download-card__meta {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .meta-label {
    font-size: 0.75rem;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .meta-value {
    font-size: 0.95rem;
    font-weight: 600;
  }

  /* Timer */
  .download-card__timer {
    margin-bottom: 1.5rem;
  }
  .timer-text {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }
  .timer-bar {
    height: 4px;
    border-radius: 4px;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .timer-bar__fill {
    height: 100%;
    width: 0%;
    background: var(--accent);
    border-radius: 4px;
  }

  /* Buttons */
  .download-card__buttons {
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .btn-download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.85rem 1.5rem;
    background: var(--accent);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .btn-download:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    text-decoration: none;
    color: #fff;
  }
  .btn-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .btn-play:hover {
    background: var(--bg-card);
    text-decoration: none;
  }

  .download-card__note {
    margin: 0 0 1.2rem;
    font-size: 0.8rem;
    color: var(--fg-subtle);
    line-height: 1.4;
  }
  .download-card__back {
    font-size: 0.88rem;
    color: var(--fg-muted);
  }
  .download-card__back:hover {
    color: var(--fg);
  }
</style>
